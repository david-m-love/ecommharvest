{
  "name": "ecommharvest-q4-masterclass",
  "private": true,
  "version": "1.0.0",
  "description": "Landing page and registration backend for the eCommHarvest Q4 masterclass",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:importmap && next build",
    "start": "next start",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "test": "tsx test/registration.test.ts && tsx test/href.test.ts && node --experimental-strip-types test/video.test.js",
    "db:start": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "seed": "payload run scripts/seed.ts",
    "test:security": "node test/security.e2e.mjs",
    "ghl:build": "node ghl/build.mjs",
    "ghl:verify": "node ghl/verify.mjs",
    "test:builder": "node test/builder.e2e.mjs",
    "test:builder:ui": "node test/builder.ui.mjs",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "vercel-build": "payload generate:importmap && payload migrate && next build",
    "test:styles": "node test/styles.ui.mjs",
    "test:logo": "node test/logo.ui.mjs",
    "test:nav": "node test/nav.ui.mjs",
    "test:tracking": "node test/tracking.ui.mjs",
    "test:manage": "node test/builder-manage.ui.mjs",
    "test:images": "node test/image-upload.ui.mjs",
    "test:mobile": "node test/mobile-editor.ui.mjs",
    "test:hosts": "node test/hosts.ui.mjs",
    "test:blog": "node test/blog.ui.mjs",
    "test:prerender": "node test/prerender.mjs",
    "test:schema": "node test/schema.mjs",
    "test:importmap": "node test/importmap.mjs",
    "test:admin": "node test/admin-boots.ui.mjs",
    "extract:pages": "node scripts/extract-pages.mjs"
  },
  "dependencies": {
    "@measured/puck": "^0.20.2",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/email-resend": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-vercel-blob": "^3.88.0",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "next": "^16.3.1",
    "payload": "^3.88.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
