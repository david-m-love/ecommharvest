# --- required ---
DATABASE_URI=postgres://user:password@host/dbname
PAYLOAD_SECRET=generate-a-long-random-string

# --- video (Cloudflare Stream) ---
# Without these the app runs with a stub provider: uploads are refused with a
# clear message rather than failing silently.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# --- masterclass registration sinks (at least one required for /api/register) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
REGISTRATION_WEBHOOK_URL=
ADMIN_TOKEN=

# --- public ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- transactional email (sign-in links) ---
# Resend. Without a key, sign-in links are printed to the server console in
# development instead of being sent, which is enough to log in locally.
#
# Get a value with `vercel env pull`, or ask David. Never commit a real key.
RESEND_API_KEY=

# Both are OPTIONAL and both already default to these values in
# src/payload.config.ts. They are here to be read, not set.
#
# The address must be on notify.ecommharvest.com — the only domain verified in
# Resend. mail.ecommharvest.com is GoHighLevel's marketing sender and is NOT
# interchangeable: pointing app email at it would be rejected, and mixing the
# two would let a marketing unsubscribe lock a paying member out of their login.
EMAIL_FROM_ADDRESS=noreply@notify.ecommharvest.com
EMAIL_FROM_NAME=Notifications
