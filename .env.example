# --- required ---
DATABASE_URI=postgres://user:password@host/dbname
PAYLOAD_SECRET=generate-a-long-random-string

# --- video (Cloudflare Stream) ---
# Without these the app runs with a stub provider: uploads are refused with a
# clear message rather than failing silently.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# --- masterclass registration sinks (at least one required for /api/register) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
REGISTRATION_WEBHOOK_URL=
ADMIN_TOKEN=

# --- public ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
