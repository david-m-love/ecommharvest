ghl/.verify/
# ghl/paste-me/ is committed on purpose. It was ignored as "generated", which
# made the files unreachable from GitHub — the only place they are ever needed,
# since pasting into GoHighLevel happens in a browser and not at a terminal.
# `ghl:verify` fails if a mirror does not match its block byte for byte, so the
# drift that ignoring them was meant to prevent cannot happen silently.

proof/artifact.html
tsconfig.tsbuildinfo

# local upload directory — production uses Vercel Blob
media/

# Generated by Next. Its contents differ between `next dev` and `next build`
# (.next/dev/types vs .next/types), so tracking it means a permanently dirty
# tree. `next build` regenerates it before type-checking, so nothing needs it
# in git.
next-env.d.ts
